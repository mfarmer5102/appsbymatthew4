{
  "name": "portfolio-backend",
  "type": "module",
  "version": "2.0.0",
  "description": "Portfolio API and MCP server: Express on an AWS Lambda Web Function, backed by Supabase",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "inspect": "npx @modelcontextprotocol/inspector --transport http --server-url http://localhost:2021/api/mcp",
    "vectorize-existing-apps": "node scripts/vectorize_existing_applications.js",
    "check-db": "node scripts/check_database.js"
  },
  "keywords": [
    "portfolio",
    "api",
    "mcp",
    "postgres",
    "supabase",
    "express"
  ],
  "author": "Matthew Farmer",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "openai": "^7.34.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
