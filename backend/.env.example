# Copy to backend/.env for local runs. In AWS there is no .env: the three secrets come
# from Secrets Manager's prd-secrets instead (src/configuration/secrets.js).

# Supabase PostgreSQL connection string. Use the transaction pooler (port 6543).
SUPABASE_DB_URL=

# Embeddings (writes, chat, MCP semantic search) and chat completions.
OPENAI_API_KEY=

# The Authorization header value every write route requires.
APPSBYMATTHEW_ADMIN_CODE=

# Optional. Local server port (default 2021). Never set AWS_LAMBDA_HTTP_ENDPOINT
# locally: it is how the code recognizes a Web Function.
# PORT=2021

# Optional. One more browser origin allowed by CORS, beyond the site's own and (locally)
# any localhost port.
# FRONTEND_URL=

# Optional. Path to a CA file for the database connection, overriding the one bundled
# at certs/supabase-prod-ca-2021.crt.
# PGSSL_ROOT_CERT=

# Optional. Encrypt without verifying the server certificate. Not needed for Supabase,
# since its CA is bundled. Last resort only.
# PGSSL_NO_VERIFY=true
