# Supabase PostgreSQL connection string. Use the transaction pooler (port 6543).
# Same value as backend/.env - this server reads the same database, read-only.
SUPABASE_DB_URL=

# Used only to embed search queries for the semantic search tool.
OPENAI_API_KEY=

# Optional. Path to a CA file for the database connection, overriding the one bundled
# at certs/supabase-prod-ca-2021.crt.
# PGSSL_ROOT_CERT=

# Optional. Encrypt without verifying the server certificate. Not needed for Supabase,
# since its CA is bundled. Last resort only.
# PGSSL_NO_VERIFY=true
